# Copy this file to .env.development and fill in the private values.
PUBLIC_ENV_MODE=development
# Temporary local/preview-only checkout fallback. The real checkout remains unchanged when unset/false.
PUBLIC_CHECKOUT_BILLING_BYPASS=false
# Additionally skip the checkout form and complete the existing fixture-only demo checkout.
# Effective only when the billing bypass above is also true.
PUBLIC_CHECKOUT_FORM_BYPASS=false

# Public frontend and self-hosted Convex routes for this environment.
PUBLIC_BASE_URL_SITE=https://eventoren.leonardomora.de
PUBLIC_BASE_URL_APP=https://eventoren.leonardomora.de
PUBLIC_BASE_URL_CONVEX=https://eventoren-convex.leonardomora.de
PUBLIC_BASE_URL_API=https://eventoren-api.leonardomora.de
VITE_CONVEX_URL=https://eventoren-convex.leonardomora.de
VITE_CONVEX_SITE_URL=https://eventoren-api.leonardomora.de
CONVEX_SITE_URL=https://eventoren-api.leonardomora.de

# Convex CLI target and admin credential. Never commit the environment file.
CONVEX_SELF_HOSTED_URL=https://eventoren-convex.leonardomora.de
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-preview-admin-key

# Application secret used by the generic auth scaffold and synced to Convex.
AUTH_SECRET=replace-with-development-secret
ZITADEL_ISSUER=https://auth.contentoren.de
ZITADEL_CLIENT_ID=replace-with-eventoren-oidc-client-id
ZITADEL_CLIENT_SECRET=replace-with-eventoren-oidc-client-secret
ZITADEL_REDIRECT_URI=https://eventoren.leonardomora.de/login/zitadel/callback
# Server-only Zitadel Management API configuration. Use a service-account token with user.read, user.grant.read, user.grant.write, and user.grant.delete.
ZITADEL_MANAGEMENT_TOKEN=replace-with-zitadel-management-api-token
ZITADEL_ORGANIZATION_ID=replace-with-eventoren-zitadel-organization-id
ZITADEL_PROJECT_ID=replace-with-eventoren-zitadel-project-id

# Private Eventoren-to-Billing integration used by Convex actions. The
# development Convex uses pasta's mapped host-gateway address to reach the
# existing host-only Billing preview directly. Never expose these in frontend
# variables.
EVENTOREN_BILLING_BASE_URL=http://169.254.1.2:3146
EVENTOREN_BILLING_ORGANIZATION_ID=replace-with-billing-organization-id
EVENTOREN_BILLING_API_CREDENTIAL=replace-with-billing-organization-api-credential
EVENTOREN_BILLING_STRIPE_MODE=test
EVENTOREN_PUBLIC_BASE_URL=https://eventoren.leonardomora.de
# Task-1 fulfillment activation. Comma-separated Billing organization IDs;
# unset or empty keeps fulfillment eligibility disabled.
EVENTOREN_BILLING_FULFILLMENT_ORGANIZATION_ALLOWLIST=
