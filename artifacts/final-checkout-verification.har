            "text": "import { language } from \"/src/app/i18n/language.ts\";\nimport { languageSignal } from \"/src/app/i18n/languageSignal.ts\";\nexport function ticketCheckoutText() {\n\tif (languageSignal.get() === language.de) {\n\t\treturn {\n\t\t\ttitle: \"Kasse\",\n\t\t\torderSummary: \"Bestellübersicht\",\n\t\t\tnoTicketsSelected: \"Noch keine Tickets gewählt\",\n\t\t\tchooseTickets: \"Wähle deine gewünschten Tickets aus\",\n\t\t\tsubtotal: \"Zwischensumme\",\n\t\t\tfees: \"Service- & Vorverkaufsgebühren\",\n\t\t\ttotal: \"Gesamtsumme\",\n\t\t\tfeesIncluded: \"Garantierter Endpreis inklusive aller Gebühren\",\n\t\t\taddToCart: \"In den Warenkorb\",\n\t\t\tdirectCheckout: \"Direkt zur Kasse\",\n\t\t\tpaymentMethods: \"Zahlungsmethoden\",\n\t\t\tsupportedPaymentMethods: \"Unterstützte Zahlungsmethoden\",\n\t\t\tdecreaseTicket: \"Ein Ticket weniger für\",\n\t\t\tincreaseTicket: \"Ein Ticket mehr für\",\n\t\t\tticketsSelected: \"Tickets gewählt\",\n\t\t\ttickets: \"Tickets\",\n\t\t\tperTicket: \"pro Ticket\",\n\t\t\tfromPrice: \"ab\",\n\t\t\tbackToCart: \"Zum Warenkorb\",\n\t\t\tbackToEvents: \"Zurück zur Event-Übersicht\",\n\t\t\tcheckoutUnavailable: \"Checkout nicht möglich\",\n\t\t\tcatalogUnavailable: \"Der Eventkatalog ist gerade nicht verfügbar. Bitte versuche es später erneut.\",\n\t\t\teventNotFound: \"Für diese Bestellung wurde kein Event gefunden. Bitte wähle ein Event neu aus.\",\n\t\t\tnoValidTickets: \"Dein Warenkorb enthält keine gültigen Tickets. Bitte wähle ein Event neu aus.\",\n\t\t\tcontactTitle: \"Kontaktdaten (Gast-Checkout)\",\n\t\t\tcontactDescription: \"Kein Konto nötig – deine Tickets kommen sofort digital.\",\n\t\t\tfirstName: \"Vorname\",\n\t\t\tlastName: \"Nachname\",\n\t\t\temail: \"E-Mail\",\n\t\t\temailHint: \"An diese Adresse senden wir deine Ticketbestätigung.\",\n\t\t\tphone: \"Telefon (optional)\",\n\t\t\tparticipantTitle: \"Teilnehmernamen\",\n\t\t\tparticipantDescription: \"Gib für jedes Ticket den Namen der teilnehmenden Person an. Die Käuferdaten bleiben davon getrennt.\",\n\t\t\tparticipant: \"Teilnehmer:in\",\n\t\t\tparticipantName: \"Name der teilnehmenden Person\",\n\t\t\tparticipantRequired: \"Bitte gib für jedes Ticket einen Teilnehmernamen an.\",\n\t\t\tticket: \"Ticket\",\n\t\t\tpayment: \"Zahlung\",\n\t\t\tpaymentDescription: \"Du wirst für die sichere Zahlung zum Zahlungsanbieter weitergeleitet. Der verbindliche Zahlungsstatus kommt anschließend vom Server zurück.\",\n\t\t\tpurchaser: \"Käufer:in\",\n\t\t\tamountDue: \"Zu zahlen\",\n\t\t\tlegalBeforeTerms: \"Ich akzeptiere die\",\n\t\t\tterms: \"AGB\",\n\t\t\tlegalBetweenLinks: \"und habe die\",\n\t\t\tprivacy: \"Datenschutzhinweise\",\n\t\t\tlegalAfterPrivacy: \"gelesen.\",\n\t\t\tsubmitting: \"Checkout wird erstellt …\",\n\t\t\tsubmit: \"Weiter zur sicheren Zahlung\",\n\t\t\temptyCart: \"Bitte wähle zuerst mindestens ein Ticket aus.\",\n\t\t\tlegalRequired: \"Bitte bestätige AGB und Datenschutzhinweise.\",\n\t\t\trequiredFields: \"Fülle alle Pflichtfelder aus\",\n\t\t\tcheckoutFailed: \"Checkout konnte nicht erstellt werden.\",\n\t\t\tlegalCta: \"Jetzt kostenpflichtig buchen\",\n\t\t\tlocale: \"de\"\n\t\t};\n\t}\n\treturn {\n\t\ttitle: \"Checkout\",\n\t\torderSummary: \"Order summary\",\n\t\tnoTicketsSelected: \"No tickets selected yet\",\n\t\tchooseTickets: \"Choose your tickets\",\n\t\tsubtotal: \"Subtotal\",\n\t\tfees: \"Service and presale fees\",\n\t\ttotal: \"Total\",\n\t\tfeesIncluded: \"Guaranteed final price including all fees\",\n\t\taddToCart: \"Add to cart\",\n\t\tdirectCheckout: \"Go directly to checkout\",\n\t\tpaymentMethods: \"Payment methods\",\n\t\tsupportedPaymentMethods: \"Supported payment methods\",\n\t\tdecreaseTicket: \"One fewer ticket for\",\n\t\tincreaseTicket: \"One more ticket for\",\n\t\tticketsSelected: \"tickets selected\",\n\t\ttickets: \"tickets\",\n\t\tperTicket: \"per ticket\",\n\t\tfromPrice: \"from\",\n\t\tbackToCart: \"Back to cart\",\n\t\tbackToEvents: \"Back to event overview\",\n\t