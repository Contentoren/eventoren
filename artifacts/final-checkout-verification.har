            "mimeType": "text/javascript",
            "size": 7445,
            "text": "import { ticketCartDraftKey } from \"/src/ticketing/ticketCartDraftKey.ts\";\nimport { ticketCartDraftMaxAgeMs } from \"/src/ticketing/ticketCartDraftMaxAgeMs.ts\";\nimport { ticketCartSearchParse } from \"/src/ticketing/ticketCartSearchParse.ts\";\nconst isTicketCart = (value) => {\n\tif (typeof value !== \"object\" || value === null) return false;\n\tconst candidate = value;\n\tif (typeof candidate.eventId !== \"string\" || candidate.eventId.length === 0) return false;\n\tif (!Array.isArray(candidate.lines)) return false;\n\treturn candidate.lines.every((line) => {\n\t\tif (typeof line !== \"object\" || line === null) return false;\n\t\tconst candidateLine = line;\n\t\treturn typeof candidateLine.tierId === \"string\" && candidateLine.tierId.length > 0 && typeof candidateLine.quantity === \"number\" && Number.isFinite(candidateLine.quantity) && candidateLine.quantity >= 0;\n\t});\n};\nexport function ticketCartDraftLoad(now = Date.now()) {\n\tif (typeof localStorage === \"undefined\") return [];\n\tlet raw = null;\n\ttry {\n\t\traw = localStorage.getItem(ticketCartDraftKey);\n\t} catch {\n\t\treturn [];\n\t}\n\tif (raw === null) return [];\n\tlet parsed = null;\n\ttry {\n\t\tparsed = JSON.parse(raw);\n\t} catch {\n\t\treturn [];\n\t}\n\tif (typeof parsed !== \"object\" || parsed === null) return [];\n\tconst candidate = parsed;\n\tif (typeof candidate.savedAt === \"number\") {\n\t\tif (now - candidate.savedAt > ticketCartDraftMaxAgeMs || candidate.savedAt > now) {\n\t\t\ttry {\n\t\t\t\tlocalStorage.removeItem(ticketCartDraftKey);\n\t\t\t} catch {}\n\t\t\treturn [];\n\t\t}\n\t}\n\tif (candidate.version === 2) {\n\t\tif (!Array.isArray(candidate.carts) || !candidate.carts.every(isTicketCart)) return [];\n\t\treturn candidate.carts;\n\t}\n\tif (typeof candidate.eventId !== \"string\" || candidate.eventId.length === 0) return [];\n\tif (typeof candidate.tickets !== \"string\") return [];\n\tconst cart = ticketCartSearchParse(candidate.eventId, candidate.tickets);\n\tif (cart.lines.length === 0) return [];\n\treturn [cart];\n}\n\n//# sourceMappingURL=data:application/json;base64,"
