            "text": "import { createEffect, createMemo } from \"/node_modules/.vite/deps/solid-js.js?v=358b62b0\";\nimport { languageSignal, languageSignalRegisterHandler } from \"/src/app/i18n/languageSignal.ts\";\nexport function rootDocumentStateCreate() {\n\tconst selectedLanguage = createMemo(() => languageSignal.get());\n\tlanguageSignalRegisterHandler();\n\tcreateEffect(() => {\n\t\tif (typeof document === \"undefined\") return;\n\t\tdocument.documentElement.lang = selectedLanguage();\n\t});\n\treturn { language: selectedLanguage };\n}\n\n//# sourceMappingURL=data:application/json;base64,"
