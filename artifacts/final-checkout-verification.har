        "response": {
          "bodySize": 15378,
          "content": {
            "mimeType": "text/javascript",
            "size": 15378,
            "text": "export const demoCatalogEvents = [\n\t{\n\t\tid: \"kraftklub-arena-berlin\",\n\t\tcatalogVersion: 1,\n\t\ttitle: \"Kraftklub — Karges Land Tour\",\n\t\tsubtitle: \"Live in der Uber Arena Berlin\",\n\t\tdescription: \"Kraftklub bringt seine neue Karges Land Tour nach Berlin. Dich erwartet ein energiegeladener Konzertabend mit Blond als Support, großer Bühnenproduktion und voller Arena-Atmosphäre.\",\n\t\tcategory: \"konzerte\",\n\t\tstartsAt: \"2027-04-16T21:00:00+02:00\",\n\t\tendsAt: \"2027-04-16T23:00:00+02:00\",\n\t\tdoorsAt: \"2027-04-16T18:30:00+02:00\",\n\t\tvenue: \"Uber Arena\",\n\t\tcity: \"Berlin\",\n\t\taddress: \"Uber-Platz 1\",\n\t\torganizer: \"Eventoren Live GmbH\",\n\t\timageUrl: \"/images/concert-crowd_460af152.webp\",\n\t\timageAlt: \"Beleuchtete Konzertbühne und feierndes Publikum\",\n\t\ttags: [\n\t\t\t\"Indie\",\n\t\t\t\"Rock\",\n\t\t\t\"Support: Blond\"\n\t\t],\n\t\tsoldOut: false,\n\t\ttiers: [\n\t\t\t{\n\t\t\t\tid: \"innenraum\",\n\t\t\t\tname: \"Innenraum Stehplatz\",\n\t\t\t\tdescription: \"Freie Platzwahl im Innenraum.\",\n\t\t\t\tpriceCents: 6900,\n\t\t\t\tfeeCents: 690,\n\t\t\t\tcapacity: 1200,\n\t\t\t\tavailable: 842\n\t\t\t},\n\t\t\t{\n\t\t\t\tid: \"oberrang\",\n\t\t\t\tname: \"Oberrang Sitzplatz\",\n\t\t\t\tdescription: \"Nummerierter Sitzplatz mit Arena-Blick.\",\n\t\t\t\tpriceCents: 7900,\n\t\t\t\tfeeCents: 790,\n\t\t\t\tcapacity: 600,\n\t\t\t\tavailable: 214\n\t\t\t},\n\t\t\t{\n\t\t\t\tid: \"early-entry\",\n\t\t\t\tname: \"Early Entry Paket\",\n\t\t\t\tdescription: \"Früher Einlass und exklusiver Innenraumzugang.\",\n\t\t\t\tpriceCents: 10900,\n\t\t\t\tfeeCents: 1090,\n\t\t\t\tcapacity: 120,\n\t\t\t\tavailable: 18\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tid: \"museumsnacht-muenchen\",\n\t\tcatalogVersion: 1,\n\t\ttitle: \"Lange Nacht der Münchner Museen\",\n\t\tsubtitle: \"Kunst, Licht und Sonderprogramme bis 2 Uhr\",\n\t\tdescription: \"Mit einem Kombiticket entdeckst du Münchens Museen, Galerien und Sammlungen in einer besonderen Nacht. Sonderführungen, Musik und Lichtkunst machen jeden Weg zur eigenen kleinen Entdeckung.\",\n\t\tcategory: \"kultur\",\n\t\tstartsAt: \"2027-10-16T19:00:00+02:00\",\n\t\tendsAt: \"2027-10-17T02:00:00+02:00\",\n\t\tdoorsAt: \"2027-10-16T18:30:00+02:00\",\n\t\tvenue: \"Königsplatz\",\n\t\tcity: \"München\",\n\t\taddress: \"Königsplatz 1\",\n\t\torganizer: \"Münchner Kulturpass\",\n\t\timageUrl: \"/images/festival-lights_3f89b9a5.webp\",\n\t\timageAlt: \"Lichtinstallation vor einer nächtlichen Veranstaltungsbühne\",\n\t\ttags: [\n\t\t\t\"Museum\",\n\t\t\t\"Nachtveranstaltung\",\n\t\t\t\"Shuttle inklusive\"\n\t\t],\n\t\tsoldOut: false,\n\t\ttiers: [{\n\t\t\tid: \"museum-standard\",\n\t\t\tname: \"Kombiticket\",\n\t\t\tdescription: \"Einlass in über 90 teilnehmende Häuser.\",\n\t\t\tpriceCents: 1800,\n\t\t\tfeeCents: 180,\n\t\t\tcapacity: 3e3,\n\t\t\tavailable: 1760\n\t\t}, {\n\t\t\tid: \"museum-reduced\",\n\t\t\tname: \"Ermäßigt\",\n\t\t\tdescription: \"Für Schüler:innen, Studierende und Senior:innen.\",\n\t\t\tpriceCents: 1200,\n\t\t\tfeeCents: 120,\n\t\t\tcapacity: 1e3,\n\t\t\tavailable: 620\n\t\t}]\n\t},\n\t{\n\t\tid: \"open-air-kino-hafen\",\n\t\tcatalogVersion: 1,\n\t\ttitle: \"Open-Air-Kino am Hafen\",\n\t\tsubtitle: \"Perfect Days (OmU) an der Mainzer Nordmole\",\n\t\tdescription: \"Ein Sommerabend am Wasser, eine große Leinwand und ein sorgfältig kuratiertes Filmerlebnis. Perfect Days läuft im Originalton mit deutschen Untertiteln unter freiem Himmel.\",\n\t\tcategory: \"kultur\",\n\t\tstartsAt: \"2027-07-24T21:15:00+02:00\",\n\t\tendsAt: \"2027-07-24T23:20:00+02:00\",\n\t\tdoorsAt: \"2027-07-24T19:30:00+02:00\",\n\t\tvenue: \"Zollhafen Nordmole\",\n\t\tcity: \"Mainz\",\n\t\taddress: \"Nordmole 1\",\n\t\torganizer: \"Hafenlicht Kulturverein\",\n\t\timageUrl: \"/images/stage-beams_0d113a31.webp\",\n\t\timageAlt: \"Scheinwerferlicht über einem abendlichen Open-Air-Gelände\",\n\t\ttags: [\n\t\t\t\"Film\",\n\t\t\t\"Open Air\",\n\t\t\t\"Originalfassung\"\n\t\t],\n\t\tsoldOut: false,\n\t\ttiers: [{\n\t\t\tid: \"kino-liegestuhl\",\n\t\t\tname: \"Reservierter Liegestuhl\",\n\t\t\tdescription: \"Bequemer Platz mit bester Sicht auf die Leinwand.\",\n\t\t\tpriceCents: 1600,\n\t\t\tfeeCents: 160,\n\t\t\tcapacity: 160,\n\t\t\tavailable: 74\n\t\t}, {\n\t\t\tid: \"kino-wiese\",\n\t\t\tname: \"Wiesenplatz\",\n\t\t\tdescription: \"Freie Platzwahl auf der Kinowiese.\",\n\t\t\tpriceCents: 1100,\n\t\t\tfeeCents: 110,\n\t\t\tcapacity: 500,\n\t\t\tavailable: 312\n\t\t}]\n\t},\n\t{\n\t\tid: \"berlin-marathon-startplatz\",\n\t\tcatalogVersion: 1,\n\t\ttitle: \"BMW Berlin-Marathon\",\n\t\tsubtitle: \"Dein Startplatz auf der Straße des 17. Juni\",\n\t\tdescription: \"Laufe durch Berlin, vorbei an den bekanntesten Wahrzeichen der Stadt, und erlebe den Zieleinlauf durch das Brandenburger Tor. Startblock, Zeitmessung und Finisher-Medaille sind Teil des Erlebnisses.\",\n\t\tcategory: \"sport\",\n\t\tstartsAt: \"2027-09-26T09:15:00+02:00\",\n\t\tendsAt: \"2027-09-26T15:30:00+02:00\",\n\t\tdoorsAt: \"2027-09-26T07:00:00+02:00\",\n\t\tvenue: \"Straße des 17. Juni\",\n\t\tcity: \"Berlin\",\n\t\taddress: \"Straße des 17. Juni 100\",\n\t\torganizer: \"Berlin Marathon Veranstaltungs GmbH\",\n\t\timageUrl: \"/images/event-production_193062e0.webp\",\n\t\timageAlt: \"Sportveranstaltung mit Startbogen und dichtem Publikum\",\n\t\ttags: [\n\t\t\t\"Laufen\",\n\t\t\t\"Marathon\",\n\t\t\t\"Zeitmessung\"\n\t\t],\n\t\tsoldOut: false,\n\t\ttiers: [{\n\t\t\tid: \"marathon-startplatz\",\n\t\t\tname: \"Startplatz\",\n\t\t\tdescription: \"Offizieller Startplatz inklusive Zeitmessung.\",\n\t\t\tpriceCents: 12500,\n\t\t\tfeeCents: 1250,\n\t\t\tcapacity: 800,\n\t\t\tavailable: 96\n\t\t}]\n\t}\n];\n\n//# sourceMappingURL=data:application/json;base64,"
          },
