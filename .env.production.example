# Copy this file to .env.production and fill in the private values.
PUBLIC_ENV_MODE=production
# Must remain false: the checkout fallback is guarded against production mode.
PUBLIC_CHECKOUT_BILLING_BYPASS=false
# Must remain false; direct fixture checkout additionally requires the billing bypass.
PUBLIC_CHECKOUT_FORM_BYPASS=false

# Public frontend and self-hosted Convex routes for this environment.
PUBLIC_BASE_URL_SITE=https://eventoren.de
PUBLIC_BASE_URL_APP=https://eventoren.de
PUBLIC_BASE_URL_CONVEX=https://convex.eventoren.de
PUBLIC_BASE_URL_API=https://api.eventoren.de
VITE_CONVEX_URL=https://convex.eventoren.de
VITE_CONVEX_SITE_URL=https://api.eventoren.de
CONVEX_SITE_URL=https://api.eventoren.de

# Convex CLI target and admin credential. Never commit the environment file.
CONVEX_SELF_HOSTED_URL=https://convex.eventoren.de
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-production-admin-key

# Application secret used by the generic auth scaffold and synced to Convex.
AUTH_SECRET=replace-with-production-secret
ZITADEL_ISSUER=https://auth.contentoren.de
ZITADEL_CLIENT_ID=replace-with-eventoren-oidc-client-id
ZITADEL_CLIENT_SECRET=replace-with-eventoren-oidc-client-secret
ZITADEL_REDIRECT_URI=https://eventoren.de/login/zitadel/callback
# Server-only Zitadel Management API configuration. Use a service-account token with user.read, user.grant.read, user.grant.write, and user.grant.delete.
ZITADEL_MANAGEMENT_TOKEN=replace-with-zitadel-management-api-token
ZITADEL_ORGANIZATION_ID=replace-with-eventoren-zitadel-organization-id
ZITADEL_PROJECT_ID=replace-with-eventoren-zitadel-project-id

# Private Eventoren-to-Billing integration used by Convex actions. Never expose these in frontend variables.
EVENTOREN_BILLING_BASE_URL=https://billing.example.invalid
EVENTOREN_BILLING_ORGANIZATION_ID=replace-with-billing-organization-id
EVENTOREN_BILLING_API_CREDENTIAL=replace-with-billing-organization-api-credential
EVENTOREN_BILLING_STRIPE_MODE=live
EVENTOREN_PUBLIC_BASE_URL=https://eventoren.de
# Task-1 fulfillment activation. Comma-separated Billing organization IDs;
# unset or empty keeps fulfillment eligibility disabled.
EVENTOREN_BILLING_FULFILLMENT_ORGANIZATION_ALLOWLIST=

# Auth SMTP runtime settings. Provide secret values only in the private .env.production file.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=starttls
AUTH_SMTP_TLS_SERVERNAME=email.contentoren.de
AUTH_SMTP_USER=
AUTH_SMTP_PASS=

# BEGIN project-creator assets-service settings
# Assets-service settings for this project. Fill non-secret values locally or in deployment configuration.
ASSETS_API_URL=https://assets-service.contentoren.de
ASSETS_PROJECT=eventoren
ASSETS_ENVIRONMENT=production

# Credential reference only: provide ASSETS_TOKEN through the environment or a secret manager.
# The credential value is intentionally not generated here.
# Organization reference: ASSETS_ORGANIZATION
# END project-creator assets-service settings
