# Copy this file to .env.production and fill in the private values.
PUBLIC_ENV_MODE=production

# Public frontend and self-hosted Convex routes for this environment.
PUBLIC_BASE_URL_SITE=https://eventoren.contentoren.de
PUBLIC_BASE_URL_APP=https://eventoren.contentoren.de
PUBLIC_BASE_URL_CONVEX=https://eventoren-convex.contentoren.de
PUBLIC_BASE_URL_API=https://eventoren-api.contentoren.de
VITE_CONVEX_URL=https://eventoren-convex.contentoren.de
VITE_CONVEX_SITE_URL=https://eventoren-api.contentoren.de
CONVEX_SITE_URL=https://eventoren-api.contentoren.de

# Convex CLI target and admin credential. Never commit the environment file.
CONVEX_SELF_HOSTED_URL=https://eventoren-convex.contentoren.de
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-production-admin-key

# Application secret used by the generic auth scaffold and synced to Convex.
AUTH_SECRET=replace-with-production-secret
ZITADEL_ISSUER=https://auth.contentoren.de
ZITADEL_CLIENT_ID=replace-with-eventoren-oidc-client-id
ZITADEL_CLIENT_SECRET=replace-with-eventoren-oidc-client-secret
ZITADEL_REDIRECT_URI=https://eventoren.leonardomora.de/login/zitadel/callback

# Private Eventoren-to-Billing integration used by Convex actions. Never expose these in frontend variables.
EVENTOREN_BILLING_BASE_URL=https://billing.example.invalid
EVENTOREN_BILLING_ORGANIZATION_ID=replace-with-billing-organization-id
EVENTOREN_BILLING_API_CREDENTIAL=replace-with-billing-organization-api-credential
EVENTOREN_BILLING_STRIPE_MODE=live
EVENTOREN_PUBLIC_BASE_URL=https://eventoren.contentoren.de
